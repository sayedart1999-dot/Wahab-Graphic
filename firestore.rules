rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: categories
    // Fields:
    //   - name: string (required)
    //   - slug: string (required)
    //   - order: number
    //
    // Collection: projects
    // Fields:
    //   - categoryId: string (required)
    //   - name: string (required)
    //   - coverImage: string (required)
    //   - images: list (strings)
    //   - description: string
    //   - canvasData: list
    //   - canvasBackgroundColor: string
    //   - canvasHeight: number
    //   - createdAt: timestamp
    //
    // Collection: messages
    // Fields:
    //   - fullName: string (required)
    //   - email: string (required, email format)
    //   - subject: string
    //   - message: string (required)
    //   - createdAt: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "sayedart1999@gmail.com" && request.auth.token.email_verified == true);
    }

    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug']) &&
             hasOnlyAllowedFields(data, ['name', 'slug', 'order', 'coverImage']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() < 100 &&
             (!('order' in data) || data.order is number) &&
             (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() < 1048500));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['categoryId', 'name', 'coverImage', 'createdAt']) &&
             hasOnlyAllowedFields(data, ['categoryId', 'name', 'coverImage', 'images', 'description', 'createdAt', 'canvasData', 'canvasBackgroundColor', 'canvasHeight']) &&
             data.categoryId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.coverImage is string && data.coverImage.size() < 1048500 &&
             data.createdAt is timestamp &&
             (!('description' in data) || (data.description is string && data.description.size() < 5000)) &&
             (!('images' in data) || data.images is list) &&
             (!('canvasData' in data) || data.canvasData is list) &&
             (!('canvasBackgroundColor' in data) || (data.canvasBackgroundColor is string && data.canvasBackgroundColor.size() < 20)) &&
             (!('canvasHeight' in data) || data.canvasHeight is number);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['fullName', 'email', 'message', 'createdAt']) &&
             hasOnlyAllowedFields(data, ['fullName', 'email', 'subject', 'message', 'createdAt']) &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.message is string && data.message.size() > 0 && data.message.size() < 2000 &&
             data.createdAt is timestamp &&
             (!('subject' in data) || (data.subject is string && data.subject.size() < 200));
    }

    // Rules
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(request.resource.data);
      allow update: if isAdmin() && isValidCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProject(request.resource.data);
      allow update: if isAdmin() && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }
    
    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
      allow read, delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
